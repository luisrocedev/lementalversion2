---
/**
 * CTAFinal.astro
 *
 * Final call to action — full-width, high-contrast,
 * gradient border card. Last thing the user sees before footer.
 */
---

<section class="cta-final section--sm" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta-final__card">
      <!-- Background glow -->
      <div class="cta-final__glow" aria-hidden="true"></div>

      <!-- Content -->
      <p class="text-label">¿Listo para el siguiente nivel?</p>
      <h2 class="cta-final__title" id="cta-title">
        Hablemos de tu<br />
        <span class="text-gradient">próximo proyecto</span>
      </h2>
      <p class="cta-final__sub">
        Sin compromisos. Una conversación de 30 minutos puede
        cambiar el rumbo de tu empresa.
      </p>
      <div class="cta-final__actions">
        <a href="/contacto" class="btn btn--primary cta-final__btn">
          Agenda una llamada
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="mailto:hola@lemental.com" class="btn btn--outline">
          hola@lemental.com
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-final__card {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-20) var(--space-16);
    text-align: center;
    /* Gradient border trick */
    background-clip: padding-box;
  }

  /* Gradient border via pseudo */
  .cta-final__card::before {
    content: '';
    position: absolute;
    inset: -1px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent), transparent 60%);
    border-radius: inherit;
    z-index: var(--z-below);
    opacity: 0.5;
  }

  /* Inner bg to cover pseudo */
  .cta-final__card::after {
    content: '';
    position: absolute;
    inset: 1px;
    background: var(--color-bg-surface);
    border-radius: calc(var(--radius-xl) - 1px);
    z-index: var(--z-below);
  }

  /* ── Glow ───────────────────────────────────────────────── */
  .cta-final__glow {
    position: absolute;
    width: 400px;
    height: 400px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, var(--color-primary-glow) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* ── Content (above z-index layers) ────────────────────── */
  .cta-final__card > *:not(.cta-final__glow) {
    position: relative;
    z-index: var(--z-raised);
  }

  .cta-final__card .text-label {
    display: block;
    margin-bottom: var(--space-4);
  }

  .cta-final__title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    margin-bottom: var(--space-6);
  }

  .cta-final__sub {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--line-height-loose);
    max-width: 480px;
    margin-inline: auto;
    margin-bottom: var(--space-10);
  }

  .cta-final__actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-final__btn {
    font-size: var(--text-base);
    padding: var(--space-4) var(--space-8);
  }
</style>
