---
/**
 * WhyUs.astro
 *
 * Differentiators section. 4 key reasons to choose Lemental.
 * Asymmetric layout: large statement left + stat grid right.
 */

interface Differentiator {
  value: string;
  label: string;
  description: string;
}

const differentiators: Differentiator[] = [
  {
    value: '100%',
    label: 'Enfoque en resultados',
    description: 'No vendemos horas. Vendemos impacto medible para tu negocio.',
  },
  {
    value: '+10',
    label: 'Años de experiencia',
    description: 'Hemos trabajado con startups, pymes y grandes corporaciones.',
  },
  {
    value: '24h',
    label: 'Tiempo de respuesta',
    description: 'Tu proyecto nunca espera. Equipo dedicado, comunicación directa.',
  },
  {
    value: '∞',
    label: 'Escalabilidad garantizada',
    description: 'Diseñamos pensando en el mañana desde el primer día.',
  },
];
---

<section class="whyus section" aria-labelledby="whyus-title">
  <div class="container whyus__inner">

    <!-- Left — Statement -->
    <div class="whyus__statement">
      <p class="text-label">Por qué elegirnos</p>
      <h2 class="whyus__title" id="whyus-title">
        No somos un proveedor.<br />
        Somos tu<br />
        <span class="text-gradient">equipo técnico</span>
      </h2>
      <p class="whyus__desc">
        Creemos que la tecnología sin estrategia es ruido. Por eso cada
        decisión que tomamos está conectada a tus objetivos de negocio.
      </p>
      <a href="/nosotros" class="btn btn--outline whyus__cta">
        Conoce el equipo
      </a>
    </div>

    <!-- Right — Stats grid -->
    <ul class="whyus__grid" role="list">
      {differentiators.map(({ value, label, description }) => (
        <li class="whyus-card">
          <span class="whyus-card__value">{value}</span>
          <strong class="whyus-card__label">{label}</strong>
          <p class="whyus-card__desc">{description}</p>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .whyus {
    position: relative;
    overflow: hidden;
  }

  .whyus::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, var(--color-primary-dim) 0%, transparent 70%);
    pointer-events: none;
  }

  /* ── Layout ─────────────────────────────────────────────── */
  .whyus__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-20);
    align-items: center;
    position: relative;
  }

  /* ── Statement ──────────────────────────────────────────── */
  .whyus__statement .text-label {
    display: block;
    margin-bottom: var(--space-4);
  }

  .whyus__title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    margin-bottom: var(--space-6);
  }

  .whyus__desc {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--line-height-loose);
    margin-bottom: var(--space-8);
  }

  /* ── Stats grid ─────────────────────────────────────────── */
  .whyus__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .whyus-card {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: border-color var(--transition-base);
  }

  .whyus-card:hover {
    border-color: var(--color-border-hover);
  }

  .whyus-card__value {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-black);
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
  }

  .whyus-card__label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .whyus-card__desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--line-height-loose);
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 900px) {
    .whyus__inner {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
  }

  @media (max-width: 480px) {
    .whyus__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
