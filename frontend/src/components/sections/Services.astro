---
/**
 * Services.astro
 *
 * Service cards grid. Each card has an icon, title, and description.
 * Data is defined inline for now — will be fetched from PHP API later.
 */

interface Service {
  icon: string;
  title: string;
  description: string;
  tags: string[];
}

const services: Service[] = [
  {
    icon: '⬡',
    title: 'Transformación Digital',
    description: 'Diseñamos la hoja de ruta para modernizar tu empresa: procesos, herramientas y cultura digital integrados.',
    tags: ['Estrategia', 'Auditoría', 'Roadmap'],
  },
  {
    icon: '◈',
    title: 'Desarrollo a Medida',
    description: 'Construimos software que encaja exactamente con tus necesidades: web, apps, APIs e integraciones.',
    tags: ['Web', 'Apps', 'API'],
  },
  {
    icon: '⬙',
    title: 'Inteligencia Artificial',
    description: 'Implementamos soluciones de IA y automatización para que tu equipo trabaje con más inteligencia y menos fricción.',
    tags: ['IA', 'Automatización', 'LLM'],
  },
  {
    icon: '◎',
    title: 'Arquitectura Cloud',
    description: 'Diseño de infraestructura escalable, segura y coste-eficiente en los principales proveedores cloud.',
    tags: ['AWS', 'Azure', 'GCP'],
  },
  {
    icon: '⬛',
    title: 'Ciberseguridad',
    description: 'Protegemos tus activos digitales con auditorías, pentesting y planes de respuesta ante incidentes.',
    tags: ['Auditoría', 'Pentesting', 'Compliance'],
  },
  {
    icon: '◬',
    title: 'Consultoría Estratégica',
    description: 'Acompañamos a dirección y equipos técnicos en la toma de decisiones tecnológicas con impacto de negocio.',
    tags: ['CTO as a Service', 'Advisory', 'OKRs'],
  },
];
---

<section class="services section" id="servicios" aria-labelledby="services-title">
  <div class="container">

    <!-- Header -->
    <div class="services__header">
      <p class="text-label">Nuestros servicios</p>
      <h2 class="services__title" id="services-title">
        Todo lo que necesitas,<br />
        <span class="text-gradient">en un solo lugar</span>
      </h2>
      <p class="services__sub">
        Desde la estrategia hasta la implementación, cubrimos cada etapa
        de tu transformación tecnológica.
      </p>
    </div>

    <!-- Grid -->
    <ul class="services__grid" role="list">
      {services.map(({ icon, title, description, tags }) => (
        <li class="service-card">
          <span class="service-card__icon" aria-hidden="true">{icon}</span>
          <h3 class="service-card__title">{title}</h3>
          <p class="service-card__desc">{description}</p>
          <ul class="service-card__tags" role="list">
            {tags.map(tag => <li class="service-card__tag">{tag}</li>)}
          </ul>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  /* ── Section header ─────────────────────────────────────── */
  .services__header {
    text-align: center;
    max-width: 600px;
    margin-inline: auto;
    margin-bottom: var(--space-16);
  }

  .services__header .text-label {
    display: block;
    margin-bottom: var(--space-4);
  }

  .services__title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    margin-bottom: var(--space-6);
  }

  .services__sub {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--line-height-loose);
  }

  /* ── Grid ───────────────────────────────────────────────── */
  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  /* ── Card ───────────────────────────────────────────────── */
  .service-card {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: border-color var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
  }

  .service-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-4px);
    box-shadow: var(--glow-primary);
  }

  .service-card__icon {
    font-size: var(--text-2xl);
    color: var(--color-primary);
    line-height: 1;
  }

  .service-card__title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-snug);
  }

  .service-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--line-height-loose);
    flex: 1;
  }

  .service-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
  }

  .service-card__tag {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary);
    background: var(--color-primary-dim);
    border: 1px solid rgba(108, 99, 255, 0.25);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    letter-spacing: var(--letter-spacing-wide);
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
